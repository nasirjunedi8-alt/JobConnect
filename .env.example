PORT=3000
DATABASE_URL=

# Leave DATABASE_URL empty to use the local JSON database.
# On Render, set DATABASE_URL to the PostgreSQL connection string from your database.

# Set mobile and a unique, strong password to provision/update the owner admin on startup.
# Name and email are optional.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional SMTP settings. Without SMTP, OTP is printed only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
